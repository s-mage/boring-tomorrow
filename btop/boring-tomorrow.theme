# Boring Tomorrow light theme for btop
# Colors from colors/Boring Tomorrow.toml
#
# In truecolor mode (default), hex values are used directly.
# In lowcolor mode (btop -l), hex values go through btop's truecolor_to_256
# conversion which maps to standard xterm indices — colors will be approximate.
# For exact palette colors, run btop without -l.

# Main background, empty for terminal default
theme[main_bg]=""

# Main text color
theme[main_fg]="#000000"

# Title color for boxes
theme[title]="#000000"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c82829"

# Background color of selected items
theme[selected_bg]="#efefef"

# Foreground color of selected items
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#8e908c"

# Graph text color
theme[graph_text]="#8e908c"

# Background color of percentage meters
theme[meter_bg]="#efefef"

# Misc colors for processes
theme[proc_misc]="#8959a8"

# Box outline colors
theme[cpu_box]="#4271ae"
theme[mem_box]="#3e999f"
theme[net_box]="#8959a8"
theme[proc_box]="#c82829"

# Box divider line
theme[div_line]="#efefef"

# Temperature graph colors
theme[temp_start]="#4271ae"
theme[temp_mid]="#3e999f"
theme[temp_end]="#8959a8"

# CPU graph colors
theme[cpu_start]="#718c00"
theme[cpu_mid]="#f5871f"
theme[cpu_end]="#c82829"

# Mem/Disk free meter
theme[free_start]="#718c00"
theme[free_mid]=""
theme[free_end]=""

# Mem/Disk cached meter
theme[cached_start]="#4271ae"
theme[cached_mid]=""
theme[cached_end]=""

# Mem/Disk available meter
theme[available_start]="#3e999f"
theme[available_mid]=""
theme[available_end]=""

# Mem/Disk used meter
theme[used_start]="#c82829"
theme[used_mid]=""
theme[used_end]=""

# Download graph colors
theme[download_start]="#4271ae"
theme[download_mid]=""
theme[download_end]="#3e999f"

# Upload graph colors
theme[upload_start]="#8959a8"
theme[upload_mid]=""
theme[upload_end]="#8959a8"
